# Dataarchy runs in a rich demo mode when Databricks is not configured.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# LOCAL AUTH OPTION A: personal access token.
# Databricks Apps deployments do not need this; the app runtime injects OAuth credentials.
DATABRICKS_TOKEN=

# LOCAL AUTH OPTION B: OAuth M2M service principal credentials.
# In Databricks Apps these are injected automatically as DATABRICKS_CLIENT_ID / SECRET.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Workspace resources. In a Databricks App these are populated from app resources through app.yaml.
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_GENIE_SPACE_ID=
DATABRICKS_MODEL_ENDPOINT=

# Default governed SQL context.
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default

# Advanced SQL mutation endpoints stay disabled unless explicitly enabled.
DATAARCHY_ALLOW_SQL_MUTATIONS=false
