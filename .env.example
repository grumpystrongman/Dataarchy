# Dataarchy runs in a rich demo mode when these are not set.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_GENIE_SPACE_ID=
# Optional but recommended: a chat/foundation model serving endpoint for BUILD/FIX/WATCH planning.
DATABRICKS_MODEL_ENDPOINT=databricks-gpt-5
# Optional: change the default catalog/schema used by SQL actions.
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
# Advanced SQL mutation endpoints stay disabled unless explicitly enabled.
DATAARCHY_ALLOW_SQL_MUTATIONS=false
